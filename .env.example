# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only, never exposed to the browser

# Auth (Credentials + JWT — see §5.3 of project plan)
JWT_SECRET=                     # generate with: openssl rand -base64 32

# Optional: redundant Vercel Cron keep-alive route (see §2.1)
CRON_SECRET=

# GitHub Actions keep-alive workflow needs these as repo secrets (Settings →
# Secrets and variables → Actions), NOT in this file:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
